# ============================================================
# DOLE Iligan Portal - Firebase & Multi-System Configuration Template
# Copy this file to .env and fill in your actual values.
# The actual .env file is gitignored. Never commit real keys.
# ============================================================

# Firebase Project Configuration (Unified Portal, SPES & GIP Datastore)
VITE_FIREBASE_PROJECT_ID=dole-portal-firebase
VITE_FIREBASE_API_KEY=firebase-local-key
VITE_FIREBASE_AUTH_DOMAIN=dole-portal-firebase.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://dole-portal-firebase-default-rtdb.firebaseio.com
VITE_FIREBASE_STORAGE_BUCKET=dole-portal-firebase.appspot.com
FIREBASE_PROJECT_ID=dole-portal-firebase
FIREBASE_API_KEY=firebase-local-key
FIREBASE_DATABASE_URL=https://dole-portal-firebase-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=dole-portal-firebase.appspot.com

# Unified REST Gateway Endpoints (Backed by Firebase Engine)
VITE_SUPABASE_URL=http://localhost:5173/api/firebase
PORTAL_SUPABASE_URL=http://localhost:5173/api/firebase

# Public Client Key (safe for frontend use)
VITE_SUPABASE_ANON_KEY=firebase-public-client-key

# Server-Only Admin Key (backend API handlers)
PORTAL_SUPABASE_SERVICE_ROLE_KEY=firebase-server-admin-role-key

# Storage Bucket name for system card image uploads
VITE_SUPABASE_STORAGE_BUCKET=system-images

# ============================================================
# External System User Search & Validation (Firebase Multi-Schema)
# ============================================================
# Frontend Client Access (VITE_ prefixed - safe anon public keys)
VITE_SPES_SUPABASE_URL=http://localhost:5173/api/firebase
VITE_SPES_SUPABASE_ANON_KEY=firebase-spes-client-key
VITE_GIP_SUPABASE_URL=http://localhost:5173/api/firebase
VITE_GIP_SUPABASE_ANON_KEY=firebase-gip-client-key

# Server-Side Backend Access (serverless handlers)
SPES_SUPABASE_URL=http://localhost:5173/api/firebase
SPES_SUPABASE_ANON_KEY=firebase-spes-client-key
GIP_SUPABASE_URL=http://localhost:5173/api/firebase
GIP_SUPABASE_ANON_KEY=firebase-gip-client-key

# ============================================================
# Vercel Server-Only Session + SSO Configuration
# Configure these in Vercel Project Settings > Environment Variables.
# Do NOT prefix these values with VITE_ and do NOT commit their real values.
# ============================================================
PORTAL_APP_ORIGIN=https://dole-portal.vercel.app
PORTAL_SESSION_TTL_HOURS=8
PORTAL_REMEMBER_SESSION_TTL_HOURS=168
PORTAL_SESSION_SECRET=replace_with_a_long_random_secret

# Optional local-only callback overrides. Leave commented out to derive callbacks from active systems.system_url records in Supabase.
# SSO_SPES_CALLBACK_URL=http://localhost:5174/sso/callback
# SSO_GIP_CALLBACK_URL=http://localhost/sso/callback

# Shared only with the corresponding target backend, never its browser/frontend.
SSO_SPES_CLIENT_SECRET=replace_with_a_long_random_secret
SSO_GIP_CLIENT_SECRET=replace_with_a_long_random_secret

# Server-only GIP directory proxy. Never prefix these names with VITE_.
GIP_DIRECTORY_URL=http://localhost/api/sso/directory.php
GIP_DIRECTORY_CLIENT_SECRET=replace_with_a_second_long_random_secret

# ============================================================
# CREAO Developer API - AI Chatbot Support Configuration
# Keep server-side API keys strictly inside your private .env file
# Use https://agent.creao.ai for capi_* Agent App keys, or https://developer.creao.ai for realtime API
# ============================================================
CREAO_API_KEY=capi_firebase_local_dole_assistant_key
CREAO_AGENT_ID=bff66ca9-b406-4de3-86a6-0cde187b24aa
CREAO_API_BASE_URL=http://localhost:5173/api/firebase

# ============================================================
# SMSAPI Gateway - Forgot Password OTP & SMS Notifications
# Keep server-side SMS credentials strictly inside your private .env file
# ============================================================
SMSAPI_UID=your_smsapi_uid_here
SMSAPI_KEY=your_smsapi_key_here
SMSAPI_BASE_URL=https://smsapi.neilian.dev/send